# Rename this file to .env and fill in your own values
# Never commit your real .env file to GitHub

# Port the backend server will run on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/contract_farming_db

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=replace_this_with_a_long_random_secret_key

# How long a JWT token stays valid
JWT_EXPIRES_IN=7d

# Used ONLY by the one-time admin seed script (npm run seed)
# These are not read by the running server otherwise
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@contractfarming.com
ADMIN_PASSWORD=replace_this_with_a_strong_password
