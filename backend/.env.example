# ==============================================================================
# CONTRACT FARMING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to .env and fill in your values.
# NEVER commit your real .env file with secrets to GitHub or version control.

# Server Port
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/contract_farming_db

# JWT Authentication Secret & Token Expiration
JWT_SECRET=replace_this_with_a_long_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Initial Admin Seeding (Used by 'npm run seed')
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@contractfarming.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Application URLs (For redirects, callbacks, and CORS)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ==============================================================================
# 1. REAL AADHAAR IDENTITY VERIFICATION CONFIGURATION (AUTHORIZED PROVIDER)
# ==============================================================================
# Operating Mode:
# - 'sandbox'     : Uses safe local simulation mode with test OTP 123456.
# - 'production'  : Connects to official authorized AUA/KUA provider API.
AADHAAR_PROVIDER_MODE=sandbox

# Selected Authorized Provider: 'SUREPASS' | 'CASHFREE'
AADHAAR_PROVIDER=SUREPASS

# --- Surepass Configuration (https://surepass.io) ---
# Obtain Bearer token from: Surepass Dashboard -> API Keys
SUREPASS_TOKEN=your_surepass_token_here
# Sandbox URL: https://sandbox.surepass.io
# Production URL: https://kyc-api.surepass.io
SUREPASS_BASE_URL=https://sandbox.surepass.io

# --- Cashfree Identity Verification (Aadhaar OKYC) (https://cashfree.com) ---
# Obtain Client ID & Secret from: Cashfree Merchant Dashboard -> Verification Suite
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
# Sandbox URL: https://sandbox.cashfree.com
# Production URL: https://api.cashfree.com
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# ==============================================================================
# 2. PAYMENT GATEWAY CONFIGURATION (RAZORPAY - UPI / CARDS / NETBANKING)
# ==============================================================================
# Operating Mode:
# - 'sandbox'     : Simulated gateway checkout for development without API keys.
# - 'test'        : Live connection to Razorpay Test Mode using rzp_test_ keys.
# - 'production'  : Live production payments using rzp_live_ keys.
PAYMENT_GATEWAY_MODE=sandbox

# Razorpay API Credentials
# Obtain from: Razorpay Dashboard (https://dashboard.razorpay.com) -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (For server-to-server payment status verification)
# Configure in: Razorpay Dashboard -> Webhooks -> Add New Webhook
# Webhook URL: http://your-domain.com/api/payments/webhook
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
